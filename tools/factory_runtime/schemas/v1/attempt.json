{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "attempt"
    },
    "job": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
    },
    "attempt": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "passed",
        "failed",
        "timeout",
        "cancelled",
        "unknown",
        "reconciled",
        "publication_recovered",
        "blocked"
      ]
    },
    "parent": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wallMs",
        "tokens"
      ],
      "properties": {
        "wallMs": {
          "type": "number",
          "minimum": 0
        },
        "tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "hashes": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-zA-Z0-9_-]{1,80}$": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "message"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "failed",
              "timeout",
              "cancelled",
              "unknown"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "publication_recovered"
          }
        }
      },
      "then": {
        "properties": {
          "hashes": {
            "required": [
              "artifact"
            ]
          }
        }
      }
    }
  ],
  "required": [
    "version",
    "kind",
    "job",
    "attempt",
    "state",
    "parent",
    "usage",
    "hashes",
    "error"
  ]
}
