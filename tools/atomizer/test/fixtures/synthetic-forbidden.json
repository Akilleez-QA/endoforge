  {
   "id": "A1",
   "statement": "the composition holds all eight parts (16 lines)",
   "check": {
    "kind": "command",
    "run": "test \"$(wc -l < /in/compose/all.txt)\" -eq 16"
   }
  },
  {
   "id": "A2",
   "statement": "every part carries the seed",
   "check": {
    "kind": "command",
    "run": "test \"$(grep -c '^seed$' /in/compose/all.txt)\" -eq 8"
   }
  }
 ],
