(module
  (import "cm32p2|endoforge:kernel/buffers@1" "[method]buffer.size" (func $size (param i32) (result i64)))
  (import "cm32p2|endoforge:kernel/buffers@1" "[method]buffer.read" (func $read (param i32 i64 i32 i32)))
  (import "cm32p2|endoforge:kernel/buffers@1" "buffer_drop" (func $drop (param i32)))
  (memory (export "cm32p2_memory") 1)
  (global $heap (mut i32) (i32.const 1024))
  (global $calls (mut i32) (i32.const 0))
  (data (i32.const 256) "1.0.0test:bytetest:none")
  (func (export "cm32p2_realloc") (param i32 i32 i32 i32) (result i32) (local $p i32)
    (if (local.get 0) (then unreachable))
    (local.set $p (i32.and
      (i32.add (global.get $heap) (i32.sub (local.get 2) (i32.const 1)))
      (i32.sub (i32.const 0) (local.get 2))))
    (global.set $heap (i32.add (local.get $p) (local.get 3)))
    (local.get $p))
  (func (export "cm32p2|endoforge:kernel/reducer@1|describe") (result i32)
    (i32.store (i32.const 128) (i32.const 256))
    (i32.store (i32.const 132) (i32.const 5))
    (i32.store (i32.const 136) (i32.const 261))
    (i32.store (i32.const 140) (i32.const 9))
    (i32.store (i32.const 144) (i32.const 261))
    (i32.store (i32.const 148) (i32.const 9))
    (i32.store (i32.const 152) (i32.const 270))
    (i32.store (i32.const 156) (i32.const 9))
    (i32.const 128))
  (func (export "cm32p2|endoforge:kernel/reducer@1|reduce")
    (param $state i32) (param $sn i32) (param $event i32) (param $en i32)
    (param $inputs i32) (param $n i32) (result i32)
    (if (i32.ne (local.get $sn) (i32.const 1)) (then unreachable))
    (if (i32.ne (local.get $en) (i32.const 1)) (then unreachable))
    (i32.store8 (i32.const 64) (i32.add (global.get $calls)
      (i32.add (i32.load8_u (local.get $state)) (i32.load8_u (local.get $event)))))
    (global.set $calls (i32.add (global.get $calls) (i32.const 1)))
    (if (local.get $n) (then
      (drop (call $size (i32.load (local.get $inputs))))
      (call $read (i32.load (local.get $inputs)) (i64.const 0) (i32.const 1) (i32.const 80))
      (if (i32.eqz (i32.load8_u (i32.const 80))) (then
        (i32.store8 (i32.const 64) (i32.add (i32.load8_u (i32.const 64))
          (i32.load8_u (i32.load (i32.const 84)))))))))
    (i32.store (i32.const 0) (i32.const 64))
    (i32.store (i32.const 4) (i32.const 1))
    (i32.store (i32.const 8) (i32.const 0))
    (i32.store (i32.const 12) (i32.const 0))
    (block $done (loop $next
      (br_if $done (i32.eqz (local.get $n)))
      (call $drop (i32.load (local.get $inputs)))
      (local.set $inputs (i32.add (local.get $inputs) (i32.const 4)))
      (local.set $n (i32.sub (local.get $n) (i32.const 1)))
      (br $next)))
    (i32.const 0))
  (func (export "cm32p2|endoforge:kernel/reducer@1|reduce_post") (param i32))
  (func (export "cm32p2|endoforge:kernel/reducer@1|describe_post") (param i32))
)
