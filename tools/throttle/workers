#!/usr/bin/env python3
"""workers: a registry of the fleet's CLI workers (Codex CLI and any agent CLI run as a job), on every host.

    workers run --bot SLUG [--task TEXT] [--repo DIR] -- CMD ...   register CMD, heartbeat while it runs, record its end
    workers list [--json] [--all] [--hours 24]                      running, dead and finished workers, every host reporting
    workers snapshot                                                this host's live workers and recent history (JSON)
    workers push --ssh HOST                                         send the snapshot to HOST (`workers receive` there)
    workers receive --from HOST                                     store a snapshot from stdin (the other end of push)
    workers reap                                                    move dead entries here into history
    workers list --receipts N | workers receipt ID                  the last N change receipts, or one in full

Written 2026-10-27 after "does grok bot have dead running computer use codex cli workers alive here?": nothing could
answer. The Grok bot's Codex workers run on the Grok box, which main-rig cannot reach (the box SSHes out to the rig,
never the other way), and on main-rig only a process list existed: no bot, no task, no history, no way to call a worker
dead. Now every launch through codex-guard.sh, codex-task or codex-pool registers here:

- An entry <host>-<pid>.json in ~/.local/state/workers/live (WORKERS_DIR overrides the root): host, bot, pid, process
  group, task label (the task's first line, secret shapes redacted, at most 80 characters), repo, program name and
  argument count, start time. Its mtime is the heartbeat, refreshed every WORKERS_BEAT seconds (30) while the command
  runs. On exit the entry moves to history.jsonl with the exit code and run time.
- Dead means the process is gone with its entry left behind (killed -9, crashed host, power loss), or the heartbeat is
  older than WORKERS_LEASE (120 s). A host whose snapshot is older than WORKERS_HOST_STALE (180 s) shows as not
  reporting: its workers are unknown, not alive.
- The box sends its snapshot with `workers push --ssh <rig>` on a timer (workshop/box/codex/workers-push.timer), so
  `workers list` on main-rig shows both machines.
- --bot must be on the roster: aors/fleet.json bot slugs plus aors/branch-slugs.json lanes and aliases. An unknown name
  (`null`, an unset variable) is refused with exit 64. WORKERS_ALLOW_UNREGISTERED=1 registers it as `unknown` instead,
  for launchers that have not been given a slug yet.
- On exit `run` writes a change receipt to receipts/<host>-<pid>-<start>.json: git HEAD, branch and diff --stat before
  and after, exit, times, the program's name and argument count, keyed digests (HMAC-SHA256, per-host key in
  digest.key, mode 0600) of the command and the task, and the evidence paths named in WORKERS_EVIDENCE (os.pathsep
  separated). No command or task text and never the environment.
- A spawn-rate alarm refuses (exit 75) a launch when this host already saw WORKERS_SPAWN_MAX (30) launches of the same
  bot and program within 60 s, refused ones included.

The registry reports; it never kills a worker. Exit status of `run` is the command's own.

Task cap (2026-10-27, after an unmerged codex-pool recursed to 465 processes and ~4,900 entries in 7 minutes with
nothing bounding the process count): `run` starts the command in a transient systemd scope with TasksMax (threads count),
bound to the caller's unit so stopping the caller still stops it, and never with weaker limits than the caller's (see
capped() and the throttle README). If systemd-run itself fails, the job runs uncapped after a warning.
"""
import argparse, json, os, signal, socket, subprocess, sys, threading, time
import fcntl, glob, hashlib, hmac, re                  # receipts, redaction and the spawn gate

HOST = socket.gethostname()


def root():
    return os.environ.get("WORKERS_DIR") or os.path.join(
        os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "workers")


def num(name, default):
    try:
        return float(os.environ.get(name, default))
    except ValueError:
        return float(default)


def repo_root():
    """The akilleez checkout that holds the roster: AKILLEEZ_ROOT, this file's own checkout, or the usual places."""
    here = os.path.realpath(__file__)
    for cand in (os.environ.get("AKILLEEZ_ROOT"), os.path.join(os.path.dirname(here), "../../../.."),
                 os.path.expanduser("~/Code/akilleez"), "/workspace/akilleez"):
        if cand and os.path.isfile(os.path.join(cand, "aors", "fleet.json")):
            return os.path.realpath(cand)
    return None


def roster(base=None):
    """Known slugs (fleet bots, lanes, aliases) or None when no roster can be found."""
    base = base or repo_root()
    if not base:
        return None
    with open(os.path.join(base, "aors", "fleet.json")) as fh:
        known = {b["slug"] for b in json.load(fh).get("bots", []) if b.get("slug")}
    try:
        with open(os.path.join(base, "aors", "branch-slugs.json")) as fh:
            extra = json.load(fh)
        known |= set(extra.get("lanes", [])) | set(extra.get("aliases", {}))
    except FileNotFoundError:
        pass
    return known


def check_bot(bot, known):
    """(slug to record, error or None)."""
    if bot and (known is None or bot in known):      # no roster on this host: record the name as given
        return bot, None
    why = f"--bot {bot!r} is not a fleet slug (aors/fleet.json, aors/branch-slugs.json)" if bot else "--bot is required"
    if os.environ.get("WORKERS_ALLOW_UNREGISTERED") == "1":
        return "unknown", None
    return None, why


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def forward(pgid, sig):
    try:
        os.killpg(pgid, sig)
    except ProcessLookupError:
        pass


# ---- task caps (shared: gpu-queue.py imports these) ----------------------------------------------------------------
import glob, re, shutil                                # task caps
def tasks_max(prefix):
    """(cap, mode). <PREFIX>_TASKS_MAX, else 128 tasks per CPU thread (min 1024). THROTTLE_TASKS: enforce (default),
    log (run uncapped and say what the cap would be) or off."""
    mode = os.environ.get("THROTTLE_TASKS", "enforce")
    mode = mode if mode in ("enforce", "log", "off") else "enforce"
    try:
        cap = int(os.environ.get(f"{prefix}_TASKS_MAX") or 0)
    except ValueError:
        cap = 0
    return (cap if cap > 0 else max(1024, 128 * (os.cpu_count() or 1))), mode


def own_cgroup(pid="self"):
    try:
        with open(f"/proc/{pid}/cgroup") as fh:
            return next((l[3:].strip() for l in fh if l.startswith("0::")), "")
    except OSError:
        return ""


LIMIT_FILES = ("pids.max", "memory.max", "memory.high", "memory.swap.max")
PROPS = {"pids.max": "TasksMax", "memory.max": "MemoryMax", "memory.high": "MemoryHigh",
         "memory.swap.max": "MemorySwapMax", "cpu": "CPUQuota"}


def chain_limits(cg):
    """The tightest finite limits on cgroup `cg` and its ancestors below the user manager: pids.max, memory.max,
    memory.high, memory.swap.max (bytes) and cpu (a CPUQuota percent); a key is missing when it is unlimited."""
    parts, out = cg.strip("/").split("/"), {}
    for i in range(len(parts), 0, -1):
        if parts[i - 1].startswith("user@"):
            break
        d = "/sys/fs/cgroup/" + "/".join(parts[:i])
        for key in LIMIT_FILES:
            try:
                with open(f"{d}/{key}") as fh:
                    v = fh.read().strip()
            except OSError:
                continue
            if v.isdigit():
                out[key] = min(out.get(key, int(v)), int(v))
        try:
            with open(f"{d}/cpu.max") as fh:
                quota, period = fh.read().split()
            if quota.isdigit() and int(period) > 0:
                pct = max(1, int(quota) * 100 // int(period))
                out["cpu"] = min(out.get("cpu", pct), pct)
        except (OSError, ValueError):
            pass
    return out


def inherited_cap(cg):
    """The tightest finite pids.max on cgroup `cg` or its ancestors below the user manager, else None."""
    return chain_limits(cg).get("pids.max")


def caller_slice(cg):
    """The slice unit the cgroup sits in under the user manager (app.slice, heavy.slice...), else None."""
    parts = cg.strip("/").split("/")
    at = next((i for i, p in enumerate(parts) if p.startswith("user@")), None)
    sl = [p for p in parts[at + 1:] if p.endswith(".slice")] if at is not None else []
    return sl[-1] if sl else None


def scope_trouble():
    """None when systemd user scopes with a working pids controller are available, else why not."""
    if not shutil.which("systemd-run"):
        return "no systemd-run"
    try:
        if subprocess.run(["systemctl", "--user", "show-environment"], capture_output=True, timeout=5).returncode:
            return "no systemd user manager"
    except (OSError, subprocess.TimeoutExpired):
        return "no systemd user manager"
    uid = os.getuid()
    try:
        with open(f"/sys/fs/cgroup/user.slice/user-{uid}.slice/user@{uid}.service/cgroup.subtree_control") as fh:
            return None if "pids" in fh.read().split() else "pids controller not delegated"
    except OSError:
        return "no cgroup v2 user manager"


def warn_once(msg):
    """Warn once per boot (a marker in XDG_RUNTIME_DIR), or every time where there is no runtime dir."""
    rt = os.environ.get("XDG_RUNTIME_DIR")
    marker = os.path.join(rt, "throttle-uncapped-warned") if rt and os.path.isdir(rt) else None
    if marker and os.path.exists(marker):
        return
    print(msg, file=sys.stderr)
    if marker:
        open(marker, "a").close()


def unit_name(prefix, name):
    """A scope name no other run can hold: THROTTLE_SCOPE_TAG (tests), prefix, name, pid and 32 random bits."""
    return (f"{os.environ.get('THROTTLE_SCOPE_TAG', '')}{prefix.lower().replace('_', '-')}-"
            f"{re.sub(r'[^A-Za-z0-9_-]', '_', name)[:40]}-{os.getpid()}-{os.urandom(4).hex()}")


def capped(cmd, prefix, name):
    """(systemd-run argv up to and without `--`, or None to run cmd in place; info).

    A job never gets weaker limits than its caller (2026-10-27 review, B1). Already under an equal or tighter task cap
    (a nested launcher) it runs in place and shares that budget. Otherwise it gets a scope of its own in the caller's
    slice, bound to the caller's unit, with TasksMax = the tighter of its cap and
    the caller's, and the caller's finite MemoryMax, MemoryHigh, MemorySwapMax and CPUQuota copied onto it. The scope's
    budget is its own: caller and job together can use up to twice the caller's limits. THROTTLE_TASKS=log adds no cap
    of ours but still copies the caller's; =off runs in place. Without systemd user scopes it warns once and runs
    uncapped. (heavy-run does the same in bash, always in heavy.slice.)"""
    cap, mode = tasks_max(prefix)
    if mode == "off":
        return None, {"mode": "off"}
    cg = own_cgroup()
    lim = chain_limits(cg)
    inherited = lim.get("pids.max")
    if inherited is not None and inherited <= cap:
        return None, {"mode": "inherited", "tasks_max": inherited}
    why = scope_trouble()
    if why:
        warn_once(f"throttle: {name}: no task cap ({why}); running uncapped")
        return None, {"mode": "uncapped", "why": why}
    unit = unit_name(prefix, name)
    bounds = [x for x in (cap if mode == "enforce" else None, inherited) if x is not None]
    tasks = min(bounds) if bounds else None
    copied = {PROPS[k]: v for k, v in lim.items() if k != "pids.max"}
    argv = ["systemd-run", "--user", "--scope", "--quiet", f"--unit={unit}", "-p", f"TasksMax={tasks or 'infinity'}"]
    argv += [a for k, v in copied.items() for a in ("-p", f"{k}={v}%" if k == "CPUQuota" else f"{k}={v}")]
    target = caller_slice(cg)
    if target:
        argv.append(f"--slice={target}")
    try:
        if "--expand-environment" in subprocess.run(["systemd-run", "--help"], capture_output=True, text=True,
                                                    timeout=5).stdout:
            argv.append("--expand-environment=no")     # systemd 254+ would otherwise expand $VARS in the command
    except (OSError, subprocess.TimeoutExpired):
        pass
    owner = cg.rsplit("/", 1)[-1]
    if "/user@" in cg and owner.endswith((".service", ".scope")) and not owner.startswith(("user@", "init.scope")):
        argv += ["-p", f"BindsTo={owner}", "-p", f"After={owner}"]
    if mode == "log":
        print(f"throttle: {name}: would cap at {cap} tasks (THROTTLE_TASKS=log)", file=sys.stderr)
    return argv, {"mode": mode, "tasks_max": tasks if mode == "enforce" else cap, "unit": unit + ".scope",
                  "slice": target, "copied": copied}


def launch(cmd, prefix, name, **popen):
    """(Popen, info): start cmd under capped(). If systemd-run itself fails (the bus went away, a unit it cannot
    create) the job still runs, uncapped, after a one-line warning, and info says mode "fallback". The job tells us it
    started by writing one byte to a pipe just before it execs, so its own exit status (1 included) is never mistaken
    for systemd-run's."""
    pre, info = capped(cmd, prefix, name)
    bash = shutil.which("bash")
    if pre is None or not bash:
        return subprocess.Popen(pre + ["--", *cmd] if pre else cmd, **popen), info
    r, w = os.pipe()
    try:
        proc = subprocess.Popen([*pre, "--", bash, "-c", f'printf . >&{w}; exec {w}>&-; exec "$@"', "throttle-job",
                                 *cmd], pass_fds=(w,), **popen)
    finally:
        os.close(w)
    try:
        started = os.read(r, 1)                        # b"" once systemd-run is gone without starting the job
    finally:
        os.close(r)
    if started:
        return proc, info
    rc = proc.wait()
    if rc < 0:                                         # killed before the job started: report that as it is
        return proc, info
    print(f"throttle: {name}: systemd-run failed (exit {rc}); running uncapped", file=sys.stderr)
    return subprocess.Popen(cmd, **popen), {**info, "mode": "fallback", "why": f"systemd-run exit {rc}", "unit": None}


class PeakWatch(threading.Thread):
    """Samples pids.peak of a launcher's scope once a second; .peak stays None when the job has no scope of its own."""
    def __init__(self, info):
        super().__init__(daemon=True)
        self.unit, self.peak, self.done = info.get("unit"), None, threading.Event()

    def run(self):
        uid, path = os.getuid(), None
        while self.unit and not self.done.wait(1 if path else 0.1):
            path = path or next(iter(glob.glob(f"/sys/fs/cgroup/user.slice/user-{uid}.slice/user@{uid}.service/"
                                               f"**/{self.unit}/pids.peak", recursive=True)), None)
            try:
                with open(path or "/nonexistent") as fh:
                    self.peak = max(self.peak or 0, int(fh.read()))
            except (OSError, ValueError):
                pass

    def stop(self):
        self.done.set()
        return self.peak


def write_json(path, data):
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh)
    os.replace(tmp, path)


def append_history(entry):
    with open(os.path.join(root(), "history.jsonl"), "a") as fh:
        fh.write(json.dumps(entry) + "\n")


# ---- change receipts and redaction --------------------------------------------------------------------------------
# A receipt holds no command or task text at all: the program's basename, the argument count and keyed digests. The
# registry (live entries, history, snapshots pushed between hosts) keeps a short label, scrubbed by scrub_text().
SEGS = (r"(?:api[-_]?key|access[-_]?key|private[-_]?key|key|token|secret|passw(?:or)?d|passphrase|pass|pwd|pw|credentials?|"
        r"cookie|auth|authorization|session[-_]?id)")
SECRET_NAME = re.compile(rf"(?i)(?<![A-Za-z0-9])(?:[A-Za-z0-9]+[-_.])*[A-Za-z0-9]*{SEGS}(?:[-_.][A-Za-z0-9]+)*$")
VALUE = r"""("[^"]*"?|'[^']*'?|[^\s'"]+)"""
REDACTIONS = [
    # Authorization headers: everything after the name
    (re.compile(r"(?i)\b((?:proxy-)?authorization\s*[:=])[^\n]*"), r"\1 [redacted]"),
    (re.compile(r"(?i)\b(bearer|basic)(\s+|[:=])[^\s'\"]+"), r"\1 [redacted]"),
    # curl -u user:password; a Slack incoming-webhook URL (the path is the secret)
    (re.compile(r"(?<![^\s'\"(])(-u\s+|--user[=\s]+)[^\s'\":]+:[^\s'\"]+"), r"\1[redacted]"),
    (re.compile(r"(?i)(hooks\.slack\.com/services/)[^\s'\"]+"), r"\1[redacted]"),
    # user:password@ or token@ in a URL
    (re.compile(r"(?i)\b([a-z][a-z0-9+.-]*://)[^/\s@'\"]+@"), r"\1[redacted]@"),
    # NAME=value, NAME: value, "name": "value" for a secret-shaped name (api_key, OPENAI_KEY, X-Api-Key, password...)
    (re.compile(rf"(?i)(?<![A-Za-z0-9])((?:[A-Za-z0-9]+[-_.])*[A-Za-z0-9]*{SEGS}(?:[-_.][A-Za-z0-9]+)*[\"']?\s*[:=]\s*)"
                + VALUE), r"\1[redacted]"),
    # --password hunter2, --api-key k inside one string; -p hunter2 and -phunter2 (mysql)
    (re.compile(rf"(?i)(?<![^\s'\"(])(--?(?:[A-Za-z0-9]+[-_])*[A-Za-z0-9]*{SEGS}(?:[-_][A-Za-z0-9]+)*\s+)" + VALUE),
     r"\1[redacted]"),
    (re.compile(r"(?<![^\s'\"(])-p(\s+[^\s'\"]+|[^\s'\"]{3,})"), "-p [redacted]"),
    # known token shapes, anywhere in a word: in a path, in quotes, in brackets
    (re.compile(r"(?<![A-Za-z0-9])(?:gh[pousr]_|github_pat_|sk-ant-|sk-|[sr]k_(?:live|test)_|xox[abposr]-|hf_|glpat-|"
                r"npm_|AIza|eyJ)[A-Za-z0-9_.+/=-]{6,}"), "[redacted]"),
    (re.compile(r"(?<![A-Za-z0-9])(?:AKIA|ASIA)[A-Z0-9]{12,}"), "[redacted]"),
    # a long unbroken run of mixed letters and digits
    (re.compile(r"[A-Za-z0-9+=]{24,}"), lambda m: "[redacted]" if re.search(r"\d", m[0]) and re.search(
        r"[A-Za-z]", m[0]) else m[0]),
]


def scrub_text(text):
    """text with every secret shape above replaced by [redacted]."""
    for pat, rep in REDACTIONS:
        text = pat.sub(rep, text)
    return text


def secret_flag(word):
    """A flag whose value is the next word: --password, --api-key, --token, -p."""
    return word == "-p" or (word.startswith("-") and "=" not in word and bool(SECRET_NAME.search(word.lstrip("-"))))


def scrub(cmd):
    """The words with secret shapes redacted (and the word after a secret-named flag), each cut to 200 after."""
    out, hide = [], False
    for word in cmd:
        out.append("[redacted]" if hide else scrub_text(word)[:200])
        hide = secret_flag(word)
    return out


def digest_key():
    """This host's random key for receipt digests (root()/digest.key, mode 0600), created once."""
    path = os.path.join(root(), "digest.key")
    os.makedirs(root(), exist_ok=True)
    for _ in range(50):
        try:
            with open(path, "rb") as fh:
                key = fh.read()
            if len(key) == 32:
                return key
        except FileNotFoundError:
            tmp = f"{path}.{os.getpid()}.tmp"
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "wb") as fh:
                fh.write(os.urandom(32))
            try:
                os.link(tmp, path)                     # atomic: the first writer's key wins
            except FileExistsError:
                pass
            os.unlink(tmp)
            continue
        time.sleep(0.01)                               # another writer is between link and write: never, but wait
    raise OSError(f"no usable digest key at {path}")


def digest(value):
    """HMAC-SHA256 of the value under this host's key: two runs of one command match, and a guessed secret inside a
    known command cannot be checked against a receipt without the key (a plain sha256 could be)."""
    return hmac.new(digest_key(), json.dumps(value).encode(), hashlib.sha256).hexdigest()


def git_state(repo):
    """HEAD and branch of the job's repo. The job may have written its .git/config, so no fsmonitor, hooks, external
    diff, textconv or optional locks run, each call stops after 5 s, and only in the caller's process. A clean or
    smudge filter the job defined can still run on a worktree diff (follow-up)."""
    def git(*args):
        try:
            r = subprocess.run(["git", "--no-optional-locks", "-c", "core.fsmonitor=", "-c", "core.hooksPath=/dev/null",
                                "-c", "diff.external=", "-C", repo, *args], capture_output=True, text=True, timeout=5,
                               stdin=subprocess.DEVNULL)
            return r.stdout.strip() if r.returncode == 0 else None
        except (OSError, subprocess.TimeoutExpired):
            return None
    head = git("rev-parse", "HEAD")
    return head and {"head": head, "branch": git("rev-parse", "--abbrev-ref", "HEAD"), "git": git}


def receipt(entry, before, after, status):
    diff = {}
    if before and after:
        stat = lambda *a: (after["git"]("diff", "--no-ext-diff", "--no-textconv", "--stat", *a) or "").splitlines()[-60:]
        if before["head"] != after["head"]:
            diff["commits"] = stat(before["head"], after["head"])
        diff["worktree"] = stat("HEAD")
    evidence = [os.path.realpath(p) for p in os.environ.get("WORKERS_EVIDENCE", "").split(os.pathsep) if p]
    side = lambda s: s and {"head": s["head"], "branch": s["branch"]}
    cmd = entry["full_cmd"]
    data = {"id": f"{HOST}-{entry['pid']}-{int(entry['started'])}", "bot": entry["bot"], "host": HOST,
            "repo": entry["repo"], "program": os.path.basename(cmd[0]), "argc": len(cmd) - 1,
            "cmd_hmac": digest(cmd), "task_hmac": digest(entry["full_task"]), "before": side(before),
            "after": side(after), "diff_stat": diff, **status, "started": entry["started"], "ended": time.time(),
            "duration": round(time.time() - entry["started"], 1), "peak_tasks": entry.get("peak_tasks"),
            "tasks_cap": entry.get("tasks_cap"),
            "evidence": [{"path": p, "exists": os.path.exists(p)} for p in evidence]}
    d = os.path.join(root(), "receipts")
    os.makedirs(d, exist_ok=True)
    write_json(os.path.join(d, data["id"] + ".json"), data)
    return data


def spawn_gate(bot, program, limit, now=None):
    """(attempts in the last 60 s, allowed): count this bot's launches of this program (its basename) on this host,
    refused ones included, and record this one, all under one lock, so a burst of simultaneous launches or a retry
    loop cannot get past the limit, and changing the arguments does not reset the count. Entries outside
    [now - 60 s, now + 5 s] (a clock step) are dropped."""
    now = time.time() if now is None else now
    os.makedirs(root(), exist_ok=True)
    with open(os.path.join(root(), "spawn.lock"), "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = os.path.join(root(), f"spawns-{HOST}.json")
        try:
            with open(path) as fh:
                rows = [r for r in json.load(fh) if now - 60 <= r[0] <= now + 5]
        except (OSError, ValueError, TypeError, IndexError):
            rows = []
        n = sum(1 for r in rows if r[1] == bot and r[2] == program)
        rows.append([now, bot, program, n < limit])
        write_json(path, rows)
    return n, n < limit


# signals whose default action dumps core, and those that cannot be caught or re-raised from Python
CORE = {getattr(signal, n) for n in ("SIGQUIT", "SIGILL", "SIGTRAP", "SIGABRT", "SIGBUS", "SIGFPE", "SIGSEGV",
                                     "SIGXCPU", "SIGXFSZ", "SIGSYS") if hasattr(signal, n)}
UNCATCHABLE = {signal.SIGKILL, signal.SIGSTOP}


def die_like(rc):
    """End as a child that ended with `rc` did: its exit code, or for death by signal N, by the same signal (callers see
    it as such), except 128 + N for SIGKILL/SIGSTOP (Python cannot reset those) and for core-dumping signals (no
    Python core dump)."""
    if rc >= 0:
        return rc
    sig = -rc
    if sig not in UNCATCHABLE | CORE:
        signal.signal(sig, signal.SIG_DFL)
        os.kill(os.getpid(), sig)
    return 128 + sig


def run(a, cmd):
    if os.environ.get("WORKERS_REGISTERED") == "1":
        # already inside a registered worker: run the command as it is, never a second entry or a nested wrapper
        os.execvp(cmd[0], cmd)
    signal.signal(signal.SIGQUIT, lambda *_: sys.exit(128 + signal.SIGQUIT))   # never a Python core dump
    # INT handled even if our caller ignored it (a background job of a shell script), so the job, in a session of its
    # own and never reached by a terminal's Ctrl-C directly, starts with INT and QUIT at their defaults
    signal.signal(signal.SIGINT, signal.default_int_handler)
    bot, err = check_bot(a.bot, roster())
    if err:
        print(f"workers: {err}; refusing to start", file=sys.stderr)
        return 64
    program, limit = os.path.basename(cmd[0]), int(num("WORKERS_SPAWN_MAX", 30))
    rate, ok = spawn_gate(bot, program, limit)                 # before any slow call (git, systemd)
    if not ok:
        print(f"workers: spawn-rate alarm: {rate} launches of {bot} {program} on {HOST} in 60 s "
              f"(WORKERS_SPAWN_MAX {limit}); refusing, a launcher is probably looping", file=sys.stderr)
        return 75
    live = os.path.join(root(), "live")
    os.makedirs(live, exist_ok=True)
    full_task = a.task if a.task is not None else (cmd[-1] if len(cmd) > 1 else "")
    task = scrub_text((full_task.strip().splitlines() or [""])[0])[:80]
    repo = os.path.realpath(a.repo) if a.repo else os.getcwd()
    before = git_state(repo)

    # the child and its descendants see WORKERS_REGISTERED=1, so a guard or launcher inside does not register again
    child, cap = launch(cmd, "WORKERS", bot, start_new_session=True,
                        env={**os.environ, "WORKERS_REGISTERED": "1", "WORKER_BOT": bot})
    watch = PeakWatch(cap)
    watch.start()
    entry = {"host": HOST, "bot": bot, "pid": child.pid, "pgid": child.pid, "wrapper": os.getpid(), "task": task,
             "repo": repo, "cmd": [program], "argc": len(cmd) - 1,
             "started": time.time()}
    path = os.path.join(live, f"{HOST}-{child.pid}.json")
    entry["tasks_cap"] = cap
    write_json(path, entry)
    stop = threading.Event()

    def beat():
        while not stop.wait(num("WORKERS_BEAT", 30)):
            try:
                os.utime(path, None)
            except FileNotFoundError:
                write_json(path, entry)

    threading.Thread(target=beat, daemon=True).start()
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP, signal.SIGQUIT):
        signal.signal(sig, lambda s, _f: forward(child.pid, s))
    rc = child.wait()
    entry["peak_tasks"] = peak = watch.stop()
    if cap.get("mode") == "log" and peak and peak >= cap["tasks_max"]:
        print(f"workers: {bot} peaked at {peak} tasks, over the {cap['tasks_max']} cap it would get", file=sys.stderr)
    stop.set()
    append_history({**entry, "ended": time.time(), "ran": round(time.time() - entry["started"], 1), "rc": rc})

    try:
        status = {"rc": rc} if rc >= 0 else {"signal": signal.Signals(-rc).name}
        receipt({**entry, "full_cmd": cmd, "full_task": full_task}, before, git_state(repo), status)
    except Exception as exc:                          # a receipt never changes the run's outcome
        print(f"workers: receipt not written ({exc})", file=sys.stderr)
    try:
        os.remove(path)
    except FileNotFoundError:
        pass
    return die_like(rc)                               # killed by a signal: die by the same one, so callers see it


def list_receipts(n, as_json):
    """The last n receipts; a file that is not a receipt (bad JSON, no id, not an object) is skipped with a note."""
    rows = []
    for f in sorted(glob.glob(os.path.join(root(), "receipts", "*.json")), key=os.path.getmtime)[-n:]:
        try:
            with open(f) as fh:
                r = json.load(fh)
            if not isinstance(r, dict) or not isinstance(r.get("id"), str):
                raise ValueError("not a receipt")
            rows.append(r)
        except (OSError, ValueError) as exc:
            print(f"workers: skipping unreadable receipt {os.path.basename(f)} ({exc})", file=sys.stderr)
    if as_json:
        print(json.dumps(rows, indent=1))
        return 0
    for r in rows:
        end = r.get("signal") or f"rc {r.get('rc')}"
        moved = str((r.get("before") or {}).get("head", ""))[:8] + ".." + str((r.get("after") or {}).get("head", ""))[:8]
        dur = r.get("duration") if isinstance(r.get("duration"), (int, float)) else 0
        print(f"  {r['id']:36} {str(r.get('bot', '?')):18} {end:8} {dur / 60:6.1f} min  "
              f"peak {r.get('peak_tasks')}  {moved}  {r.get('program', '')} ({r.get('argc', '?')} args)")
    return 0


def local_live(now=None):
    now = now or time.time()
    out, live = [], os.path.join(root(), "live")
    for name in sorted(os.listdir(live)) if os.path.isdir(live) else []:
        if not name.endswith(".json"):
            continue
        path = os.path.join(live, name)
        try:
            with open(path) as fh:
                e = json.load(fh)
            beat = os.stat(path).st_mtime
        except (OSError, ValueError):
            continue
        gone = e.get("host") == HOST and not alive(e.get("pid", -1))
        stale = now - beat > num("WORKERS_LEASE", 120)
        out.append({**e, "heartbeat": beat, "state": "dead" if gone or stale else "running",
                    "why": "process gone, entry left" if gone else ("no heartbeat" if stale else "")})
    return out


def history(hours):
    cut, out = time.time() - hours * 3600, []
    try:
        with open(os.path.join(root(), "history.jsonl")) as fh:
            for line in fh:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if e.get("ended", 0) >= cut:
                    out.append({**e, "state": "finished"})
    except FileNotFoundError:
        pass
    return out


def snapshot(hours=24):
    return {"host": HOST, "sent": time.time(), "live": local_live(), "history": history(hours)[-200:]}


def remote(now=None):
    """Snapshots other hosts sent; their live workers are 'not reporting' once the snapshot is stale."""
    now = now or time.time()
    out, hosts = [], os.path.join(root(), "hosts")
    for name in sorted(os.listdir(hosts)) if os.path.isdir(hosts) else []:
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(hosts, name)) as fh:
                snap = json.load(fh)
        except (OSError, ValueError):
            continue
        age = now - snap.get("sent", 0)
        quiet = age > num("WORKERS_HOST_STALE", 180)
        for e in snap.get("live", []):
            out.append({**e, "state": "unknown" if quiet else e.get("state"),
                        "why": f"host not reporting for {age:.0f} s" if quiet else e.get("why", "")})
        out.extend({**e, "state": "finished"} for e in snap.get("history", []))
        out.append({"host": snap.get("host", name[:-5]), "state": "host", "age": round(age), "quiet": quiet})
    return out


def show(rows, all_rows):
    hosts = [r for r in rows if r["state"] == "host"]
    rows = [r for r in rows if r["state"] != "host"]
    now = time.time()
    print(f"workers on {HOST}" + "".join(f", {h['host']} ({'NOT REPORTING ' if h['quiet'] else ''}{h['age']} s ago)" for h in hosts))
    order = {"dead": 0, "unknown": 1, "running": 2, "finished": 3}
    shown = [r for r in rows if all_rows or r["state"] != "finished"]
    for r in sorted(shown, key=lambda r: (order.get(r["state"], 9), -r.get("started", 0))):
        end = r.get("ended") or now
        print(f"  {r['state'].upper():8} {r.get('host', '?'):14} {r.get('bot', '?'):22} pid {r.get('pid', '?'):<8} "
              f"{(end - r.get('started', end)) / 60:6.1f} min  {r.get('task', '')[:70]}"
              + (f"  [{r['why']}]" if r.get("why") else "") + (f"  rc {r['rc']}" if "rc" in r else ""))
    counts = {s: sum(1 for r in rows if r["state"] == s) for s in order}
    print("  " + ", ".join(f"{n} {s}" for s, n in counts.items() if n or s in ("running", "dead")))


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    cmd = []
    if "--" in argv:
        i = argv.index("--")
        argv, cmd = argv[:i], argv[i + 1:]
    ap = argparse.ArgumentParser(prog="workers")
    sub = ap.add_subparsers(dest="op", required=True)
    r = sub.add_parser("run")
    r.add_argument("--bot")
    r.add_argument("--task")
    r.add_argument("--repo")
    li = sub.add_parser("list")
    li.add_argument("--json", action="store_true")
    li.add_argument("--all", action="store_true", help="include finished workers")
    li.add_argument("--hours", type=float, default=24)
    li.add_argument("--receipts", type=int, metavar="N", help="show the last N change receipts instead")
    sub.add_parser("receipt").add_argument("id")
    sub.add_parser("snapshot")
    p = sub.add_parser("push")
    p.add_argument("--ssh", required=True)
    rc = sub.add_parser("receive")
    rc.add_argument("--from", dest="src", required=True)
    sub.add_parser("reap")
    sl = sub.add_parser("slug")
    sl.add_argument("name")
    a = ap.parse_args(argv)
    os.makedirs(root(), exist_ok=True)
    if a.op == "run":
        if not cmd:
            ap.error("run needs a command after --")
        return run(a, cmd)
    if a.op == "receipt":
        path = os.path.join(root(), "receipts", os.path.basename(a.id).removesuffix(".json") + ".json")
        if not os.path.exists(path):
            print(f"workers: no receipt {a.id}", file=sys.stderr)
            return 66
        print(open(path).read())
        return 0
    if a.op == "list" and a.receipts:
        return list_receipts(a.receipts, a.json)
    if a.op == "list":
        rows = local_live() + [{**e, "host": e.get("host", HOST)} for e in history(a.hours)] + remote()
        if a.json:
            print(json.dumps(rows, indent=1))
        else:
            show(rows, a.all)
        return 1 if any(r["state"] == "dead" for r in rows) else 0
    if a.op == "snapshot":
        print(json.dumps(snapshot()))
        return 0
    if a.op == "push":
        data = json.dumps(snapshot())
        res = subprocess.run(["ssh", "-o", "BatchMode=yes", a.ssh, ".local/bin/workers", "receive", "--from", HOST],
                             input=data, text=True, capture_output=True, timeout=60)
        if res.returncode:
            print(f"workers: push to {a.ssh} failed: {res.stderr.strip()[:300]}", file=sys.stderr)
        return res.returncode
    if a.op == "receive":
        src = "".join(c for c in a.src if c.isalnum() or c in "-._")[:64] or "unknown"
        data = json.loads(sys.stdin.read())
        os.makedirs(os.path.join(root(), "hosts"), exist_ok=True)
        write_json(os.path.join(root(), "hosts", f"{src}.json"), {**data, "host": src, "sent": time.time()})
        return 0
    if a.op == "slug":
        known = roster()
        if known is None:
            print("workers: no roster found (set AKILLEEZ_ROOT)", file=sys.stderr)
            return 69
        ok = a.name in known
        if not ok:
            print(f"workers: {a.name!r} is not a fleet slug (aors/fleet.json, aors/branch-slugs.json)", file=sys.stderr)
        return 0 if ok else 64
    if a.op == "reap":
        n = 0
        for e in local_live():
            if e["state"] == "dead" and e.get("host") == HOST:
                append_history({k: v for k, v in e.items() if k not in ("state", "why")} |
                               {"ended": e["heartbeat"], "rc": "lost", "why": e["why"]})
                os.remove(os.path.join(root(), "live", f"{HOST}-{e['pid']}.json"))
                n += 1
        print(f"workers: reaped {n} dead entr{'y' if n == 1 else 'ies'}")
        return 0


if __name__ == "__main__":
    sys.exit(main())
