  {
    "requestId": "CC-013",
    "arm": "incumbent",
    "path": "campaigns/hillclimb-loop-01/work/runs/s3/inc-low-r1-CC-013/CC-013",
    "signatures": {
      "dewPointF": {
        "params": [
          124,
          124
        ],
        "results": [
          124
        ]
      }
    },
    "glue": {
      "id": "CC-013",
      "assumption": "RH is taken as relative to liquid water (the normal instrument and weather convention), and the result is the dew point, not the frost point. It is computed with the Magnus formula (a = 17.62, b = 243.12 C).",
      "question": "Is your 50% RH reading relative to water or to ice, and do you want the dew point or the frost point?",
      "notes": "Below 32 F, moisture actually deposits as frost. If RH is relative to ice, the frost point is higher than the dew point shown.",
      "exports": [
        {
          "name": "dewPointF",
          "label": "What is the dew point for this temperature and RH",
          "headline": true,
          "args": [
            {
              "name": "tempF",
              "kind": "number",
              "unit": "\u00b0F",
              "label": "Dry-bulb air temperature",
              "range": "-49..140 \u00b0F (Magnus fit range)"
            },
            {
              "name": "rhPct",
              "kind": "number",
              "unit": "% RH",
              "label": "Relative humidity",
              "range": "greater than 0, up to 100"
            }
          ],
          "result": {
            "kind": "number",
            "unit": "\u00b0F",
            "precision": 1
          }
        }
      ],
      "traps": [
        {
          "fn": "dewPointF",
          "when": "RH is 0 or below, or above 100",
          "message": "Relative humidity must be greater than 0 and no more than 100 %. Enter the RH reading in percent."
        },
        {
          "fn": "dewPointF",
          "when": "temperature below -49 \u00b0F or above 140 \u00b0F",
          "message": "The temperature is outside the -49 to 140 \u00b0F range where this formula is accurate. Enter a dry-bulb temperature inside that range."
        }
      ]
    },
    "sources": {
      "campaigns/hillclimb-loop-01/work/runs/s3/inc-low-r1-CC-013/CC-013/glue.json": "bd916fe6f7aafedd1c91a2068ec83821a7c38722a55e335eee50efbff065fe30",
      "campaigns/hillclimb-loop-01/work/runs/s3/inc-low-r1-CC-013/CC-013/kernel.wasm": "cf7a28702c56aee011afc6721a2f6dd1a34758cae59e9ccb1a9c7ec5fdc101e2",
      "campaigns/hillclimb-loop-01/work/runs/s3/inc-low-r1-CC-013/CC-013/CONTRACT.md": "30fbfd85e5b7c191ca23237c382afd5d0847b3858ab566952d672337299ac64c"
    }
