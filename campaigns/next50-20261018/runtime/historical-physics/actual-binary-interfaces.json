    },
    "glue": {
      "id": "CC-013",
      "assumption": "Temperature is dry-bulb air in \u00b0F and RH is relative to liquid water (normal hygrometer reading), so the result is the dew point, not the frost point; Magnus formula, pressure-independent.",
      "question": "Is the 50% RH reading from a standard hygrometer (relative to liquid water, not ice), with the answer wanted in \u00b0F?",
      "notes": "Valid for dry-bulb -60..140 \u00b0F and RH above 0 up to 100%. At sub-freezing temperatures the frost point is slightly higher than this dew point.",
      "exports": [
        {
          "name": "dewpoint_f",
          "label": "Dew point at the given dry-bulb temperature and relative humidity",
          "headline": true,
          "args": [
            {
              "name": "temp_f",
              "kind": "number",
              "unit": "\u00b0F",
              "label": "Dry-bulb air temperature",
              "range": "-60..140"
            },
            {
              "name": "rh_pct",
              "kind": "number",
              "unit": "%",
              "label": "Relative humidity",
              "range": "greater than 0, up to 100"
            }
          ],
          "result": {
            "kind": "number",
            "unit": "\u00b0F",
            "precision": 1
          }
        }
      ],
      "traps": [
        {
          "fn": "dewpoint_f",
          "when": "temperature outside -60..140 \u00b0F, relative humidity <= 0 or > 100, or a non-finite value",
          "message": "Refused: temperature must be -60 to 140 \u00b0F and relative humidity above 0 and at most 100 %; supply values in those ranges."
        }
      ]
    },
    "sources": {
      "tools/atomizer/work/baseline-20/runs/CC-013/atoms/direct/work/CC-013/glue.json": "e9ab2e96b70d63876ca90e832cff3a0822bb4b70ea41c42ad3cb55523e8e5581",
