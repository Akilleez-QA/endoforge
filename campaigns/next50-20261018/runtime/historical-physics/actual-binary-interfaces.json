      }
    },
    "glue": {
      "id": "C-007",
      "assumption": "Assumes a TXV/EXV-metered system where normal subcooling is 8-12 \u00b0F, and that the reading is a subcooling difference in \u00b0F. Manufacturer targets override this window.",
      "question": "Is the system metered by a TXV/EXV or a fixed orifice (piston), and does the manufacturer give a target subcooling?",
      "notes": "Fixed-orifice systems are judged by superheat, so this check does not apply to them. 45 \u00b0F is far above the typical window.",
      "exports": [
        {
          "name": "subcool_is_normal",
          "label": "Is this subcooling normal?",
          "headline": true,
          "args": [
            {
              "name": "delta_f",
              "kind": "number",
              "unit": "\u00b0F",
              "label": "Subcooling (saturation temp minus liquid-line temp)",
              "range": "0..100"
            }
          ],
          "result": {
            "kind": "boolean",
            "unit": "flag",
            "labels": {
              "true": "Normal (8-12 \u00b0F)",
              "false": "Not normal for a TXV system (outside 8-12 \u00b0F)"
            }
          }
        },
        {
          "name": "subcool_class",
          "label": "How far is this subcooling from normal?",
          "args": [
            {
              "name": "delta_f",
              "kind": "number",
              "unit": "\u00b0F",
              "label": "Subcooling",
              "range": "0..100"
            }
          ],
          "result": {
            "kind": "code",
            "unit": "code",
            "codes": {
              "0": "low (below 5 \u00b0F)",
              "1": "slightly low (5 to below 8 \u00b0F)",
              "2": "normal (8-12 \u00b0F)",
              "3": "high (above 12 to 20 \u00b0F)",
              "4": "very high (above 20 \u00b0F)"
            }
          }
        }
      ],
      "traps": [
        {
          "fn": "subcool_class",
          "when": "input is NaN, infinite, negative or above 100 \u00b0F",
          "message": "That is not a physically meaningful subcooling difference; recheck the readings and supply a value from 0 to 100 \u00b0F."
        },
        {
          "fn": "subcool_is_normal",
          "when": "input is NaN, infinite, negative or above 100 \u00b0F",
          "message": "That is not a physically meaningful subcooling difference; recheck the readings and supply a value from 0 to 100 \u00b0F."
        }
      ]
    },
    "sources": {
      "tools/atomizer/work/baseline-20/runs/C-007/atoms/direct/work/C-007/glue.json": "7b0e8f8ece30d541c8d6febfcbdf98638cdd57e4dd2dfb386d081d033cacf7ac",
