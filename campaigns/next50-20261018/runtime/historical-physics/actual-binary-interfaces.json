    "glue": {
      "id": "CC-009",
      "assumption": "Assumes ammonia (R-717). A bottom-feed overfeed evaporator runs about 70% full of liquid at the 3:1 ratio. The -2 F temperature sets the liquid density, and the 5 inHg suction pressure is not used.",
      "question": "Is the refrigerant ammonia, and is the 5 inHg suction pressure a vacuum reading? For ammonia, -2 F is about 15.7 psig.",
      "notes": "This is an estimate for charge planning. Ammonia is toxic, so check the figure against the coil manufacturer's charge data.",
      "exports": [
        {
          "name": "evaporatorInventoryLb",
          "label": "Normal inventory of the evaporator",
          "headline": true,
          "args": [
            {
              "name": "volumeFt3",
              "kind": "number",
              "unit": "ft3",
              "label": "Evaporator internal volume",
              "range": ">= 0"
            },
            {
              "name": "tempF",
              "kind": "number",
              "unit": "F",
              "label": "Operating temperature",
              "range": "-60..50 F fit range"
            },
            {
              "name": "feedCode",
              "kind": "code",
              "unit": "code",
              "label": "Evaporator feed type",
              "codes": {
                "0": "direct expansion",
                "1": "top-feed overfeed",
                "2": "bottom-feed overfeed",
                "3": "flooded"
              }
            },
            {
              "name": "recircRatio",
              "kind": "number",
              "unit": "dimensionless",
              "label": "Recirculation ratio (x:1)",
              "range": ">= 1 for overfeed"
            }
          ],
          "result": {
            "kind": "number",
            "unit": "lb",
            "precision": 0
          }
        },
        {
          "name": "ammoniaLiquidDensity",
          "label": "Liquid ammonia density at operating temperature",
          "args": [
            {
              "name": "tempF",
              "kind": "number",
              "unit": "F",
              "label": "Operating temperature",
              "range": "-60..50 F fit range"
            }
          ],
          "result": {
            "kind": "number",
            "unit": "lb/ft3",
            "precision": 2
          }
        },
        {
          "name": "fillFraction",
          "label": "Fraction of evaporator volume filled with liquid",
          "args": [
            {
              "name": "feedCode",
              "kind": "code",
              "unit": "code",
              "label": "Evaporator feed type",
              "codes": {
                "0": "direct expansion",
                "1": "top-feed overfeed",
                "2": "bottom-feed overfeed",
                "3": "flooded"
              }
            }
          ],
          "result": {
            "kind": "number",
            "unit": "dimensionless",
            "precision": 2
          }
        }
      ],
      "traps": [
        {
          "fn": "evaporatorInventoryLb",
          "when": "volume is negative, or an overfeed recirculation ratio is below 1",
          "message": "The volume must be zero or more, and an overfeed recirculation ratio must be at least 1:1. Supply the coil's internal volume in ft3 and its ratio."
        },
        {
          "fn": "fillFraction",
          "when": "feed code is not 0, 1, 2 or 3",
          "message": "Unknown feed type. Use 0 for direct expansion, 1 for top-feed overfeed, 2 for bottom-feed overfeed or 3 for flooded."
        }
      ]
    },
    "sources": {
