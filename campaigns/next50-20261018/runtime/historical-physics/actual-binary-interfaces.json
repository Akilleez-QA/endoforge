  {
    "requestId": "C-007",
    "arm": "incumbent",
    "path": "campaigns/hillclimb-loop-01/work/runs/s3/inc-low-r1-C-007/C-007",
    "signatures": {
      "classifySubcooling": {
        "params": [
          124,
          124
        ],
        "results": [
          127
        ]
      },
      "subcoolingDeviation": {
        "params": [
          124,
          124
        ],
        "results": [
          124
        ]
      }
    },
    "glue": {
      "id": "C-007",
      "assumption": "Target subcooling is assumed to be 10 \u00b0F (typical for a TXV/EEV system) with a \u00b15 \u00b0F tolerance, unless you enter the manufacturer's target.",
      "question": "What target subcooling does the equipment's nameplate or manufacturer charging chart specify?",
      "notes": "High subcooling can mean overcharge or a liquid-line restriction. Check the filter-drier temperature drop before removing refrigerant. Wear gloves and eye protection when connecting gauges.",
      "exports": [
        {
          "name": "classifySubcooling",
          "label": "Is my subcooling low, OK or high?",
          "headline": true,
          "args": [
            {
              "name": "measured",
              "kind": "number",
              "unit": "\u00b0F",
              "label": "Measured subcooling (sub cooler delta)",
              "range": "0..100"
            },
            {
              "name": "target",
              "kind": "number",
              "unit": "\u00b0F",
              "label": "Target subcooling from nameplate (10 if unknown)",
              "range": "> 0 and <= 100"
            }
          ],
          "result": {
            "kind": "code",
            "unit": "code",
            "codes": {
              "0": "Low: possible undercharge",
              "1": "Within \u00b15 \u00b0F of target",
              "2": "High: possible overcharge or restriction"
            }
          }
        },
        {
          "name": "subcoolingDeviation",
          "label": "How far is my subcooling from target?",
          "args": [
            {
              "name": "measured",
              "kind": "number",
              "unit": "\u00b0F",
              "label": "Measured subcooling (sub cooler delta)",
              "range": "0..100"
            },
            {
              "name": "target",
              "kind": "number",
              "unit": "\u00b0F",
              "label": "Target subcooling from nameplate (10 if unknown)",
              "range": "> 0 and <= 100"
            }
          ],
          "result": {
            "kind": "number",
            "unit": "\u00b0F",
            "precision": 1
          }
        }
      ],
      "traps": [
        {
          "fn": "classifySubcooling",
          "when": "measured subcooling outside 0..100 \u00b0F or target not positive",
          "message": "That subcooling reading isn't physically plausible. Enter a measured subcooling between 0 and 100 \u00b0F and a positive target from the nameplate (use 10 if unknown)."
        },
        {
          "fn": "subcoolingDeviation",
          "when": "measured subcooling outside 0..100 \u00b0F or target not positive",
          "message": "That target or reading can't be used. Enter a measured subcooling between 0 and 100 \u00b0F and a target above 0 \u00b0F from the nameplate (use 10 if unknown)."
        }
      ]
    },
    "sources": {
      "campaigns/hillclimb-loop-01/work/runs/s3/inc-low-r1-C-007/C-007/glue.json": "e799e935023d1a4fa7c4e0cf6a5f3d7c4a684451b1d530ab76a632ceda15d2f4",
