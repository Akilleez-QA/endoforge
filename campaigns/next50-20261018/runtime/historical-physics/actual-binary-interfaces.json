    "glue": {
      "id": "CC-009",
      "assumption": "Refrigerant is ammonia; liquid fraction is 0.50 for bottom feed and 0.25 for top feed regardless of recirculation ratio; liquid density 42.30 - 0.0209 x T(F) lb/ft3 (-40..40 F). Suction pressure is not used.",
      "question": "Is the refrigerant ammonia, and is the 5 inHg figure really the suction pressure at -2 F?",
      "exports": [
        {
          "name": "evap_inventory_lb",
          "label": "normal refrigerant inventory of the evaporator",
          "headline": true,
          "args": [
            {
              "name": "volume_ft3",
              "kind": "number",
              "unit": "ft3",
              "label": "evaporator internal volume",
              "range": "> 0"
            },
            {
              "name": "temp_F",
              "kind": "number",
              "unit": "F",
              "label": "operating temperature",
              "range": "-40..40 F"
            },
            {
              "name": "recirc_ratio",
              "kind": "number",
              "unit": "dimensionless",
              "label": "recirculation ratio",
              "range": ">= 1"
            },
            {
              "name": "feed_code",
              "kind": "code",
              "unit": "code",
              "label": "feed type",
              "codes": {
                "1": "bottom feed",
                "2": "top feed"
              },
              "range": "1 or 2"
            }
          ],
          "result": {
            "kind": "number",
            "unit": "lb",
            "precision": 1
          }
        }
      ],
      "traps": [
        {
          "fn": "evap_inventory_lb",
          "when": "volume <= 0, temp outside -40..40 F, ratio < 1, or feed code not 1 or 2",
          "message": "Inputs out of range: give volume > 0 ft3, temperature -40..40 F, recirculation ratio >= 1, feed 1 (bottom) or 2 (top)."
        }
      ]
    },
    "sources": {
