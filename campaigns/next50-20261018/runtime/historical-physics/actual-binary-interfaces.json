          127
        ]
      }
    },
    "glue": {
      "id": "CC-022",
      "assumption": "No refrigerant or table was named, so this treats the gas as an ideal gas sealed in a rigid vessel, where the pressure change per degree F equals absolute pressure divided by absolute temperature; the claim counts as true only within 5 percent.",
      "question": "Which refrigerant is in the system, and at roughly what saturation temperature (for example R-410A at a 40 F evaporator)?",
      "notes": "There is no fixed psi-per-degree-F rule: the rate depends on the refrigerant and the temperature, so the general statement is false.",
      "exports": [
        {
          "name": "claimTrue",
          "label": "Is a 1 F temperature drop equal to the claimed psi pressure drop?",
          "headline": true,
          "args": [
            {
              "name": "claimed",
              "kind": "number",
              "unit": "psi/F",
              "label": "Claimed pressure drop per 1 F",
              "range": "> 0"
            },
            {
              "name": "p",
              "kind": "number",
              "unit": "psia",
              "label": "Absolute pressure of the gas",
              "range": "> 0"
            },
            {
              "name": "t",
              "kind": "number",
              "unit": "F",
              "label": "Gas temperature",
              "range": "> -459.67"
            }
          ],
          "result": {
            "kind": "boolean",
            "unit": "flag",
            "labels": {
              "true": "True at these conditions",
              "false": "False at these conditions"
            }
          }
        },
        {
          "name": "psiPerDegF",
          "label": "Actual pressure drop per 1 F temperature drop",
          "args": [
            {
              "name": "p",
              "kind": "number",
              "unit": "psia",
              "label": "Absolute pressure of the gas",
              "range": "> 0"
            },
            {
              "name": "t",
              "kind": "number",
              "unit": "F",
              "label": "Gas temperature",
              "range": "> -459.67"
            }
          ],
          "result": {
            "kind": "number",
            "unit": "psi/F",
            "precision": 3
          }
        }
      ],
      "traps": [
        {
          "fn": "psiPerDegF",
          "when": "pressure is zero or negative, or temperature is at or below -459.67 F",
          "message": "Pressure must be absolute (psia, above 0; add 14.7 to a gauge reading) and temperature must be above absolute zero. Supply both and try again."
        },
        {
          "fn": "claimTrue",
          "when": "the claimed rate is zero or negative",
          "message": "The claimed pressure drop per degree must be a positive number of psi; supply the value being checked, such as 3.47."
        }
      ]
    },
    "sources": {
