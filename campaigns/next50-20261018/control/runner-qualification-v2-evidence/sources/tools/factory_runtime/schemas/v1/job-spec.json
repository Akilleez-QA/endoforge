{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "job": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
    },
    "attempt": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
    },
    "input": {
      "type": "string"
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expectedSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "script": {
      "type": "string"
    },
    "timeoutSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 600
    }
  },
  "required": [
    "version",
    "job",
    "attempt",
    "input",
    "inputSha256",
    "expectedSha256",
    "script",
    "timeoutSeconds"
  ]
}
