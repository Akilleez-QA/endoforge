{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "endoforge/x1-spec-study/factory/glue.schema.json",
  "title": "Declarative glue for one dark-factory capability (work/factory/<id>/glue.json)",
  "description": "What the kernel cannot say for itself: labels, units, precision, the assumption, the question and the trap messages. Validated by gate G7 in gate.mjs. The schema is closed: no property outside this file is allowed anywhere.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "assumption", "question", "exports", "traps"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "description": "Must equal the folder name." },
    "assumption": { "type": "string", "minLength": 20, "description": "The stated assumption the kernel was built against, as one or two sentences printed with every answer." },
    "question": { "type": "string", "minLength": 20, "description": "The one question the requester would be asked to settle the assumption. Must be answerable by the requester." },
    "notes": { "type": "string", "description": "Optional: a safety or presentation note printed with every answer (flammability, phase-out, 'excludes tax')." },
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "label", "args", "result"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "The wasm export name." },
          "label": { "type": "string", "minLength": 5, "description": "What the function answers, in the requester's words." },
          "headline": { "type": "boolean", "description": "True on the one export that answers the request as asked." },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "unit"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "enum": ["number", "integer", "boolean", "code"] },
                "unit": { "type": "string", "minLength": 1, "description": "SI or field unit, or 'dimensionless', 'count', 'flag', 'code'." },
                "label": { "type": "string", "minLength": 1 },
                "codes": { "$ref": "#/$defs/codes", "description": "Required when kind is code: every integer value the kernel accepts, with its meaning." },
                "range": { "type": "string", "description": "Accepted range in words, e.g. '0..100', '>= 0', '-40..40 F fit range'." }
              }
            }
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "unit"],
            "properties": {
              "kind": { "type": "string", "enum": ["number", "integer", "boolean", "code"] },
              "unit": { "type": "string", "minLength": 1 },
              "precision": { "type": "integer", "minimum": 0, "maximum": 6, "description": "Decimal places at field precision. Required for number." },
              "codes": { "$ref": "#/$defs/codes", "description": "Required for code results." },
              "labels": {
                "type": "object",
                "additionalProperties": false,
                "required": ["true", "false"],
                "properties": { "true": { "type": "string", "minLength": 1 }, "false": { "type": "string", "minLength": 1 } },
                "description": "Required for boolean results."
              }
            }
          }
        }
      }
    },
    "traps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fn", "when", "message"],
        "properties": {
          "fn": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "The export that traps." },
          "when": { "type": "string", "minLength": 5, "description": "The input condition, in words." },
          "message": { "type": "string", "minLength": 10, "description": "What the requester is told: why, and what to supply instead." }
        }
      }
    }
  },
  "$defs": {
    "codes": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": { "pattern": "^-?[0-9]+$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
